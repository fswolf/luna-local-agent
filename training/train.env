# Settings for training/train.sh. Any of them can be given on the command
# line instead, e.g.  BASE=/models/qwen-9b training/train.sh gesture

# The full-size (safetensors) version of the exact model she runs - not the
# GGUF. A Hugging Face id (downloaded once into ~/.cache/huggingface) or a
# folder on disk. Her current model is DavidAU's Qwen3.5-9B Defiant Fable
# Heretic; find its safetensors repo on Hugging Face and put it here.
BASE="${BASE:-}"

# The GGUF the patch is for, by file name without .gguf. Empty = the one
# llama/start.sh last started (it notes it in llama/patches/.current_model).
FOR_MODEL="${FOR_MODEL:-}"

# How hard it learns. Small and gentle, so it picks up a habit without
# forgetting how to call tools (docs/patches.md).
RANK="${RANK:-16}"
EPOCHS="${EPOCHS:-2}"
LR="${LR:-1e-4}"
MAX_LEN="${MAX_LEN:-8192}"       # tokens; longer examples are left out (her whole prompt counts). Lower it if memory runs out
LOAD_4BIT="${LOAD_4BIT:-1}"      # 1: a 9B fits a 16 GB card. 0 needs about twice the memory

# The container: podman or docker (empty = whichever is installed), and the
# PyTorch ROCm build to put in it (rocm6.4 for ROCm 6.x drivers, rocm7.2 for 7.x).
ENGINE="${ENGINE:-}"
ROCM="${ROCM:-rocm6.4}"
IMAGE="${IMAGE:-luna-trainer}"
