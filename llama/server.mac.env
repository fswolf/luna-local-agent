# llama-server settings for a Mac (Apple Silicon, Metal) - start.sh uses
# this instead of server.env when it runs on macOS. Tuned on a Mac mini
# where server.env's desktop values starved CoreAudio: Luna's voice cut
# out ("AudioQueueStart failed ('what')") while the model was working.
# Machine-specific bits (a MODEL path on an external drive) go in
# server.local.env, which isn't committed and is read last.
# The values mirror what LM Studio loads "Qwen3.5 9B The Defiant Fable
# Uncnr Heretic NEO MAX" with, so the two behave the same.

# The GGUF. Leave MODEL empty and start.sh finds it in LM Studio's own
# model folders by MODEL_MATCH - the same file, no second copy. Set a
# full path to use something else.
MODEL=""
MODEL_MATCH="*defiant*fable*"

# Vision: the mmproj file is the model's eyes, a separate GGUF next to
# it. Empty = find one in the model's own folder (where LM Studio puts
# it), or by MMPROJ_MATCH; "off" = never; or a full path. Without it
# llama-server refuses every screenshot with "image input is not
# supported". A finetune uses its base model's mmproj (e.g. the
# Qwen3.5-9B one) when it doesn't ship its own.
MMPROJ=""
MMPROJ_MATCH=""

# What the model is called over the API - the name in Luna's header
# and in the thought log. Empty = the file name.
ALIAS=""

HOST="127.0.0.1"          # localhost only, like everything else here
PORT=8080

CTX=16384                 # Context Length
NGL=99                    # GPU Offload: LM Studio's 32 is every layer; 99 = all
THREADS=6                 # CPU Thread Pool Size
BATCH=2048                # Evaluation Batch Size
UBATCH=512               # Physical Batch Size
PARALLEL=1                # Max Concurrent Predictions - 1 keeps memory and GPU load down
KV_UNIFIED=1              # Unified KV Cache - slots share CTX instead of splitting it
CTX_CHECKPOINTS=32        # Context Checkpoints

# Thinking. deepseek puts the scratchpad in reasoning_content, which is
# where Luna's thought log looks first. -1 = no budget; 0 = thinking off.
REASONING_FORMAT="deepseek"
REASONING_BUDGET=-1

# Anything else, passed straight through, e.g. "--control-vector x.gguf"
EXTRA="--load-mode none"  # load the model into RAM once, no reading from disk mid-reply

# --- The embedding server, for recalling facts by meaning ---
# start.sh runs it beside the chat server when the model is found.
# Get it into llama/models, or through LM Studio (search "Qwen3-Embedding-0.6B"):
#   curl -L -o llama/models/Qwen3-Embedding-0.6B-Q8_0.gguf \
#     https://huggingface.co/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/main/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED=auto                # auto = if the model's there; off = never; on = refuse to start without it
EMBED_MODEL=""
EMBED_MATCH="*qwen3-embedding*"
EMBED_PORT=8081
EMBED_CTX=2048
EMBED_POOLING="last"       # Qwen3-Embedding is trained for last-token pooling; empty = whatever the file says

# --- The reranker, for picking the best of those matches ---
# A second small model that reads what you said beside each candidate
# fact and scores how well it answers it - slower than the embedding
# model but sharper, so it only re-orders the embedding's top matches.
# Optional, about 0.6 GB on disk and under 1 GB of VRAM. Skip it on a
# machine short of memory (a 16 GB Mac): recall works without it.
#   curl -L -o llama/models/qwen3-reranker-0.6b-q8_0.gguf \
#     https://huggingface.co/ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF/resolve/main/qwen3-reranker-0.6b-q8_0.gguf
RERANK=off                # auto = if the model's there; off = never, even if it is; on = refuse to start without it
RERANK_MODEL=""
RERANK_MATCH="*qwen3-reranker*"
RERANK_PORT=8082
RERANK_CTX=2048
