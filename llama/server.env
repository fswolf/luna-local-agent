# llama-server settings - edit freely, start.sh reads this every launch.
# The values mirror what LM Studio loads "Qwen3.5 9B The Defiant Fable
# Uncnr Heretic NEO MAX" with, so the two behave the same.

# The GGUF. Leave MODEL empty and start.sh finds it in LM Studio's own
# model folders by MODEL_MATCH - the same file, no second copy. Set a
# full path to use something else.
MODEL=""
MODEL_MATCH="*defiant*fable*"

# What the model is called over the API - the name in Luna's header
# and in the thought log. Empty = the file name.
ALIAS=""

HOST="127.0.0.1"          # localhost only, like everything else here
PORT=8080

CTX=16384                 # Context Length
NGL=99                    # GPU Offload: LM Studio's 32 is every layer; 99 = all
THREADS=9                 # CPU Thread Pool Size
BATCH=4096                # Evaluation Batch Size
UBATCH=2048               # Physical Batch Size
PARALLEL=4                # Max Concurrent Predictions
KV_UNIFIED=1              # Unified KV Cache - the 4 slots share CTX instead of a quarter each
CTX_CHECKPOINTS=32        # Context Checkpoints

# Thinking. deepseek puts the scratchpad in reasoning_content, which is
# where Luna's thought log looks first. -1 = no budget; 0 = thinking off.
REASONING_FORMAT="deepseek"
REASONING_BUDGET=-1

# Anything else, passed straight through, e.g. "--control-vector x.gguf"
EXTRA=""

# --- The embedding server, for recalling facts by meaning ---
# start.sh runs it beside the chat server when the model is found.
# Get it into llama/models, or through LM Studio (search "Qwen3-Embedding-0.6B"):
#   curl -L -o llama/models/Qwen3-Embedding-0.6B-Q8_0.gguf \
#     https://huggingface.co/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/main/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED=auto                # auto = if the model's there; off = never; on = refuse to start without it
EMBED_MODEL=""
EMBED_MATCH="*qwen3-embedding*"
EMBED_PORT=8081
EMBED_CTX=2048
EMBED_POOLING="last"       # Qwen3-Embedding is trained for last-token pooling; empty = whatever the file says
