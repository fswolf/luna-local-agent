__pycache__/
*.pyc

# Conversation log, the full transcript archive, scheduled reminders
# and the long-term fact database - all personal, all regenerated at
# runtime.
history/conversation.json
history/transcript.jsonl
reminders/reminders.json
agent/facts.db
agent/mood.json
agent/facts.db-wal
agent/facts.db-shm
agent/thoughts.db
agent/thoughts.db-wal
agent/thoughts.db-shm
# Cached embeddings of her facts - derived from personal data, rebuilt on demand.
agent/embeddings.db
agent/embeddings.db-wal
agent/embeddings.db-shm
# Lessons and session notes (notebook.py) - about your conversations.
agent/notebook.db
agent/notebook.db-wal
agent/notebook.db-shm
# Scheduled jobs (plugins/cron.py) - yours, like reminders.
agent/cron.json

# llama.cpp is built in place by llama/install.sh; only the scripts and
# the settings file are ours.
llama/llama.cpp/
llama/bin/
llama/slots/
llama/*.log
# The key llama/start.sh makes - a secret, never committed.
llama/.api_key

# Injection experiments: her answers (personal) and vectors (model-specific).
introspection/results/
introspection/vectors/

# Screenshots and previews dropped here while working
Claude outputs/

# Virtualenvs, in case one ever lands inside the repo
ai-voice-venv/
.venv/
venv/
tts/*/venv/
tts/*/qwentts.cpp/
tts/*/models/
*.gguf

# Reference voice clips are recordings, not source.
tts/*/voices/*
!tts/*/voices/README.md

# Plugins are tracked - all of them, including any you add later.
# This used to be an allow-list, which meant a new plugin was invisible
# to `git add -A` until you remembered to name it here, and the only
# symptom was a push that quietly left it behind.
#
# The trade is that plugins/ now goes to GitHub as-is, so keep anything
# private out of the file itself. Credentials already live in
# ~/.config/ai-voice/ rather than beside the code, and channel or
# account names belong in config.json, not hard-coded in the plugin.

# Credentials. The real ones live in ~/.config/ai-voice/, outside the
# repo entirely - these are here in case a copy ever lands beside the
# code by accident.
pomf.json
irc.json
discord.json
*.key

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store

# Portrait models you add (often large, always someone else's licence),
# Live2D's core, and Blender's backup files. placeholder.vrm and luna.vrm stay.
portrait/models/*/
portrait/models/luna.glb
portrait/vendor/live2dcubismcore.min.js
*.blend1

# Made by installer/install.py on this machine
install.json
.venv/
luna.cmd
Luna.command
